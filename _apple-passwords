#compdef pw otp pwlogin pwrun awsmfa pwssh npmotp pw-git pw-docker pw-make pw-hooks
# Completion for the apple-passwords plugin. Sites and usernames come from the plugin's
# local cache of past lookups (Apple's protocol can't list the whole vault). No secrets.

local cache=${XDG_CACHE_HOME:-$HOME/.cache}/apple-passwords/accounts
local -a lines sites
[[ -r $cache ]] && lines=("${(@f)$(<$cache)}")
sites=(${(u)lines%%$'\t'*})

local curcontext=$curcontext state state_descr line
typeset -A opt_args

case $service in
  pw|otp|pwlogin)
    local -a opts
    [[ $service != pwlogin ]] && opts=(
      '(-c --copy -p --print)'{-c,--copy}'[copy to the clipboard]'
      '(-c --copy -p --print)'{-p,--print}'[print to stdout]'
    )
    _arguments -s -C $opts '(- *)'{-h,--help}'[show help]' \
      '1:site:->site' '2:username:->user'
    case $state in
      site) _describe -t sites 'site' sites ;;
      user)
        local -a users
        users=(${(u)${(M)lines:#${(b)line[1]}$'\t'*}#*$'\t'})
        _describe -t users 'username' users ;;
    esac
    ;;
  awsmfa)
    local -a profiles f
    for f in ${AWS_CONFIG_FILE:-$HOME/.aws/config} ${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}; do
      [[ -r $f ]] && profiles+=(${${${(M)${(f)"$(<$f)"}:#\[*\]}#\[(profile |)}%\]})
    done
    _arguments -s '(-c --clear)'{-d,--duration}'[session length in seconds]:seconds:' \
      '(- *)'{-c,--clear}'[remove the MFA session from this shell]' \
      '(- *)'{-h,--help}'[show help]' "1:profile:(${(u)profiles})"
    ;;
  pwssh|npmotp)
    local -a tools=(ssh scp sftp rsync git) default=ssh
    [[ $service == npmotp ]] && tools=(npm pnpm yarn) default=npm
    if (( CURRENT > 2 )) && (( ${tools[(Ie)$words[2]]} )); then
      shift words; (( CURRENT-- ))
    else
      words[1]=$default
    fi
    _normal
    ;;
  pw-hooks|pw-make)
    local -a names
    [[ -r Makefile ]] && names=(${${(M)${(f)"$(<Makefile)"}:#[A-Za-z0-9_.%/-]##:*}%%:*})
    [[ -r package.json ]] && (( $+commands[jq] )) && names+=(${(f)"$(jq -r '.scripts // {} | keys[]' package.json 2>/dev/null)"})
    if [[ $service == pw-make ]]; then
      _arguments '1:action:(add remove list detect)' "2:target pattern:($names)" '3:site:_describe -t sites site sites'
    else
      _arguments '1:action:(add remove list detect)' '2:kind:(make script)' "3:pattern:($names)" '4:site:_describe -t sites site sites'
    fi
    ;;
  pw-git|pw-docker)
    _arguments '1:action:(enable disable list)' '2:host:_hosts'
    ;;
  pwrun)
    _arguments -s -C \
      '*--pg[PGHOST/PGUSER/PGPASSWORD]:[user@]host:->site' \
      '*--mysql[MYSQL_HOST/MYSQL_PWD]:[user@]host:->site' \
      '*--twine[TWINE_USERNAME/TWINE_PASSWORD]:[user@]site:->site' \
      '*-e[inject a password into the environment]:VAR=[user@]site:->spec' \
      '*-t[inject the current 2FA code into the environment]:VAR=[user@]site:->spec' \
      '(- *)'{-h,--help}'[show help]' \
      '(-):command:_command_names -e' \
      '*::arguments:_normal'
    if [[ $state == site ]]; then
      compset -P '*@'; _describe -t sites 'site' sites
    elif [[ $state == spec ]]; then
      if compset -P '*='; then
        compset -P '*@'
        _describe -t sites 'site' sites
      else
        _message 'VAR=[user@]site'
      fi
    fi
    ;;
esac
