#!/bin/zsh -f
# docker credential helper (docker-credential-* protocol) backed by Apple Passwords.
# Enable per registry with `pw-docker enable <registry>` (credHelpers in ~/.docker/config.json).
# `store`/`erase` are accepted and ignored — Apple Passwords stays the source of truth.
emulate zsh -o extended_glob
APPLE_PW_NO_SETUP=1
source ${0:A:h:h}/apple-passwords.plugin.zsh

case $1 in
  get) ;;
  store|erase) cat >/dev/null; exit 0 ;;
  list) print '{}'; exit 0 ;;
  *) print -u2 "usage: docker-credential-apple-passwords get|store|erase|list"; exit 1 ;;
esac

url=$(cat)
host=${${${url#*://}%%/*}%%:*}
case $host in
  index.docker.io|registry-1.docker.io|docker.io) site=docker.com ;;   # Docker Hub logins
  *) site=$host ;;
esac
typeset -a reply
if ! _apwz_get pw $site; then
  print "credentials not found in native keychain"
  exit 1
fi
# Secret goes to jq on stdin (not argv) to be JSON-encoded.
print -rn -- $reply[1] | jq -Rsc --arg url $url --arg u $reply[2] '{ServerURL: $url, Username: $u, Secret: .}'
