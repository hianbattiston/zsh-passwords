#!/bin/zsh -f
# git credential helper: answers git's HTTPS credential requests from Apple Passwords.
# Enable per host with `pw-git enable <host>` (sets credential.https://<host>.helper).
# Only `get` is implemented; `store`/`erase` are ignored — Apple Passwords stays the source.
emulate zsh -o extended_glob
APPLE_PW_NO_SETUP=1
source ${0:A:h:h}/apple-passwords.plugin.zsh

if [[ $1 != get ]]; then cat >/dev/null; exit 0; fi
typeset -A req
local line
while IFS= read -r line && [[ -n $line ]]; do req[${line%%=*}]=${line#*=}; done
[[ $req[protocol] == http(|s) && -n $req[host] ]] || exit 0

typeset -a reply
_apwz_get pw ${req[host]%%:*} "$req[username]" || exit 0    # nothing printed → git asks as usual
print -r -- "username=$reply[2]"
print -r -- "password=$reply[1]"
